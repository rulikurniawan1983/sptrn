{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch Built-in Server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-S",
                "127.0.0.1:8000",
                "-t",
                "public"
            ],
            "port": 8000,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Development Server \\(http://127.0.0.1:8000\\) started"
            }
        }
    ]
}
